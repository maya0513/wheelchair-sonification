   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">In recent years high-frequency brain activity in the gamma-frequency band (30‚Äì80 Hz) and above has become the focus of a growing body of work in MEG/EEG research.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">High-frequency brain activity and muscle artifacts in MEG/EEG: a review and recommendations</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Suresh D. Muthukumaraswamy</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>high-frequency activity</rdf:li>
               <rdf:li>muscle artifacts</rdf:li>
               <rdf:li>gamma-band activity</rdf:li>
               <rdf:li>magnetoencephalography</rdf:li>
               <rdf:li>electroencephalography</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
